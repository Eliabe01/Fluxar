
# Firebase (client-side) - Used in src/lib/firebase.ts
# These are public and safe to commit.
# NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="..."
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="..."
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="..."
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="..."
# NEXT_PUBLIC_FIREBASE_APP_ID="..."

# Your app's public URL
NEXT_PUBLIC_APP_URL="http://localhost:9002"

# Stripe (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."


# -----------------------------------------------------------
# --- SERVER-SIDE / SECRET KEYS ---
# --- DO NOT COMMIT .env FILE WITH THESE VALUES ---
# -----------------------------------------------------------

# Genkit/Google AI
GEMINI_API_KEY="..."

# Stripe (server-side)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Subscription Price IDs
# Make sure these match the lookup_keys in your Stripe product catalog.
STRIPE_PRICE_ID_BRONZE="bronze"
STRIPE_PRICE_ID_PRATA="prata"
STRIPE_PRICE_ID_OURO="oro"

# Firebase Admin SDK (server-side)
# Used for Genkit flows. Point this to the location of your service account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-file.json"
