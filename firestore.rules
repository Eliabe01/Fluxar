rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== FUNÇÕES AUXILIARES =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Verifica se o usuário autenticado tem a custom claim 'admin'
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // A regra principal para a coleção de usuários
    match /users/{userId}/{documents=**} {
      // Admins podem ler e escrever em qualquer documento de qualquer usuário.
      // Usuários normais só podem ler e escrever em seus próprios documentos.
      allow read, write: if isAdmin() || isOwner(userId);
    }
  }
}
